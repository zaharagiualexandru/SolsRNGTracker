            </Grid>


            <!-- BOTTOM SWEEP -->

            <Grid Height="7"
                  VerticalAlignment="Bottom"
                  ClipToBounds="True">

                <Rectangle Width="260"
                           Height="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
