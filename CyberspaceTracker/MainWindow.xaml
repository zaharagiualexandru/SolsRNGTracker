                    </Rectangle.Fill>


                    <Rectangle.Effect>

                        <BlurEffect Radius="4"/>

                    </Rectangle.Effect>


                    <Rectangle.RenderTransform>

                        <TranslateTransform x:Name="EdgeSweepLeft"
                                            Y="-220"/>

                    </Rectangle.RenderTransform>

                </Rectangle>

            </Grid>


            <!-- RIGHT SWEEP -->

            <Grid Width="7"
                  HorizontalAlignment="Right"
                  ClipToBounds="True">

                <Rectangle Width="2"
                           Height="190"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Opacity="0.78">

                    <Rectangle.Fill>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                            <GradientStop Color="#00FFFFFF"
                                          Offset="0"/>

                            <GradientStop Color="#708698FF"
                                          Offset="0.25"/>

                            <GradientStop Color="#EEF3FF"
                                          Offset="0.55"/>

                            <GradientStop Color="#708698FF"
                                          Offset="0.80"/>

                            <GradientStop Color="#00FFFFFF"
                                          Offset="1"/>

                        </LinearGradientBrush>

                    </Rectangle.Fill>


                    <Rectangle.Effect>

                        <BlurEffect Radius="4"/>

                    </Rectangle.Effect>


                    <Rectangle.RenderTransform>

                        <TranslateTransform x:Name="EdgeSweepRight"
                                            Y="760"/>

                    </Rectangle.RenderTransform>

                </Rectangle>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- TRACKER UI                                            -->
        <!-- ===================================================== -->

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <TextBlock Text="Cyberspace Tracker"
                       Foreground="#F2F5FF"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,26"/>


            <!-- ================================================= -->
            <!-- SUMMARY CARDS                                     -->
            <!-- ================================================= -->

            <UniformGrid Grid.Row="1"
                         Columns="4"
                         Margin="0,0,0,26">


                <!-- TOTAL -->

                <Border Style="{StaticResource SummaryCard}">

                    <StackPanel>

                        <TextBlock Text="Total rolls"
                                   Style="{StaticResource CardLabel}"/>

                        <TextBlock x:Name="TotalRollsText"
                                   Text="0"
                                   Style="{StaticResource CardValue}"/>

                    </StackPanel>

                </Border>


                <!-- META - PURE WHITE -->

                <Border Style="{StaticResource SummaryCard}">

                    <StackPanel>

                        <TextBlock Text="Meta"
                                   Style="{StaticResource CardLabel}"
                                   Foreground="#FFFFFF"/>

                        <TextBlock x:Name="TotalMetaText"
                                   Text="0"
                                   Style="{StaticResource CardValue}"
                                   Foreground="#FFFFFF"/>

                    </StackPanel>

                </Border>


                <!-- ILLUSIONARY -->

                <Border Style="{StaticResource SummaryCard}">

                    <StackPanel>

                        <TextBlock x:Name="SummaryIllusionaryLabel"
                                   Style="{StaticResource CardLabel}"
                                   Text="illusionary"/>

                        <TextBlock x:Name="TotalIllusionaryText"
                                   Text="0"
                                   Style="{StaticResource CardValue}"/>

                    </StackPanel>

                </Border>


                <!-- ILLUSIONARY CHANCE -->

                <Border Style="{StaticResource SummaryCard}"
                        Margin="0">

                    <StackPanel>

                        <WrapPanel>

                            <TextBlock x:Name="SummaryIllusionaryChanceIllusionaryLabel"
                                       Style="{StaticResource CardLabel}"
                                       Text="illusionary"/>

                            <TextBlock Text=" chance"
                                       Style="{StaticResource CardLabel}"/>

                        </WrapPanel>


                        <TextBlock x:Name="OverallChanceText"
                                   Text="0.00%"
                                   Style="{StaticResource CardValue}"
                                   Foreground="#9797FF"/>

                    </StackPanel>

                </Border>

            </UniformGrid>


            <!-- ================================================= -->
            <!-- SESSION TITLE                                     -->
            <!-- ================================================= -->

            <DockPanel Grid.Row="2"
                       Margin="0,0,0,14">

                <TextBlock Text="Session history"
                           Foreground="#EDF3FF"
                           FontSize="18"/>


                <TextBlock x:Name="SessionCountText"
                           Text="0 cyberspaces"
                           Foreground="#A5ACD0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>

            </DockPanel>


            <!-- ================================================= -->
            <!-- TABLE                                             -->
            <!-- ================================================= -->

            <Border Grid.Row="3"
                    Background="#F10C1020"
                    BorderBrush="#30365F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="8">

                <DataGrid x:Name="SessionsTable"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          Background="Transparent"
                          Foreground="#EDF3FF"
                          BorderThickness="0"
                          RowBackground="#11162A"
                          AlternatingRowBackground="#0D1122"
                          RowHeight="46"
                          ColumnHeaderHeight="44"
                          FontSize="14"
                          FontWeight="Bold">


                    <DataGrid.Resources>


                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#0C1020"/>

                            <Setter Property="Foreground"
                                    Value="#A5ACD0"/>

                            <Setter Property="FontWeight"
                                    Value="Bold"/>

                            <Setter Property="Padding"
                                    Value="10,8"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                        </Style>


                        <Style TargetType="DataGridCell">

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Setter Property="Padding"
                                    Value="10,0"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="DataGridCell">

                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">

                                            <ContentPresenter VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>


                            <Style.Triggers>

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#30305B"/>

                                    <Setter Property="Foreground"
                                            Value="White"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.Resources>


                    <DataGrid.Columns>


                        <DataGridTextColumn Header="#"
                                            Binding="{Binding Number}"
                                            Width="55"/>


                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
                                            Width="*"
                                            MinWidth="120"/>


                        <DataGridTextColumn Header="Warp"
                                            Binding="{Binding Warps}"
                                            Width="75"/>


                        <DataGridTextColumn Header="Tidal"
                                            Binding="{Binding TidalWaveShifters}"
                                            Width="75"/>


                        <DataGridCheckBoxColumn Header="PLC"
                                                Binding="{Binding PlcEnabled}"
                                                Width="65"/>


                        <DataGridTextColumn Header="Total rolls"
                                            Binding="{Binding TotalRolls, StringFormat=N0}"
                                            Width="*"
                                            MinWidth="135"/>


                        <!-- META PURE WHITE -->

                        <DataGridTextColumn Binding="{Binding Metas}"
                                            Width="75">

                            <DataGridTextColumn.Header>

                                <TextBlock Text="Meta"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold"/>

                            </DataGridTextColumn.Header>


                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Foreground"
                                            Value="#FFFFFF"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>


                        <!-- ILLUSIONARY -->

                        <DataGridTextColumn Binding="{Binding Illusionaries}"
                                            Width="115">

                            <DataGridTextColumn.Header>

                                <TextBlock x:Name="TableIllusionaryHeader"
                                           Text="illusionary"
                                           FontWeight="Bold"/>

                            </DataGridTextColumn.Header>

                        </DataGridTextColumn>


                        <DataGridTextColumn Header="Chance"
                                            Binding="{Binding ChanceDisplay}"
                                            Width="100"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- ================================================= -->
            <!-- BUTTONS                                           -->
            <!-- ================================================= -->

            <Grid Grid.Row="4"
                  Margin="0,18,0,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel Orientation="Horizontal">

                    <Button x:Name="AddSessionButton"
                            Content="+ Add Cyberspace"
                            Background="#4141DA"/>


                    <Button x:Name="EditSessionButton"
                            Content="Edit selected"
                            Margin="10,0,0,0"/>


                    <Button x:Name="DeleteSessionButton"
                            Content="Delete selected"
                            Foreground="#DCA5B5"
                            Margin="10,0,0,0"/>

                </StackPanel>


                <CheckBox x:Name="PauseMotion"
                          Grid.Column="1"
                          Content="Pause background"
                          Foreground="#A5ACD0"
                          Margin="16,0,0,0"
                          VerticalAlignment="Center"/>

            </Grid>

        </Grid>


        <!-- ===================================================== -->
        <!-- BACKGROUND ANIMATIONS                                 -->
        <!-- ===================================================== -->

        <Grid.Triggers>

            <EventTrigger RoutedEvent="FrameworkElement.Loaded">

                <BeginStoryboard Name="BackgroundMotion">

                    <Storyboard>


                        <DoubleAnimation Storyboard.TargetName="OuterRingSpin"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="360"
                                         Duration="0:1:10"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="MiddleRingSpin"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="-360"
                                         Duration="0:0:52"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="InnerRingSpin"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="360"
                                         Duration="0:0:34"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="BurstSpinA"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="360"
                                         Duration="0:0:32"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="BurstSpinB"
                                         Storyboard.TargetProperty="Angle"
                                         From="0"
                                         To="-360"
                                         Duration="0:0:24"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="AuraGlow"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.17"
                                         To="0.29"
                                         Duration="0:0:4"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="AuraGlowOuter"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.08"
                                         To="0.17"
                                         Duration="0:0:5.4"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="CoreBloom"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.62"
                                         To="0.84"
                                         Duration="0:0:1.8"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="CoreScale"
                                         Storyboard.TargetProperty="ScaleX"
                                         From="0.97"
                                         To="1.06"
                                         Duration="0:0:2.1"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="CoreScale"
                                         Storyboard.TargetProperty="ScaleY"
                                         From="0.97"
                                         To="1.06"
                                         Duration="0:0:2.1"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="TechDrift"
                                         Storyboard.TargetProperty="X"
                                         From="-6"
                                         To="8"
                                         Duration="0:0:7"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="TechDrift"
                                         Storyboard.TargetProperty="Y"
                                         From="-4"
                                         To="6"
                                         Duration="0:0:8.5"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="ShardDrift"
                                         Storyboard.TargetProperty="Y"
                                         From="-10"
                                         To="12"
                                         Duration="0:0:5"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="FramePulse"
                                         Storyboard.TargetProperty="Opacity"
                                         From="0.07"
                                         To="0.19"
                                         Duration="0:0:2.5"
                                         AutoReverse="True"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="EdgeSweepTop"
                                         Storyboard.TargetProperty="X"
                                         From="-300"
                                         To="1500"
                                         Duration="0:0:4.2"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="EdgeSweepBottom"
                                         Storyboard.TargetProperty="X"
                                         From="1500"
                                         To="-300"
                                         Duration="0:0:5.1"
                                         BeginTime="0:0:0.8"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="EdgeSweepLeft"
                                         Storyboard.TargetProperty="Y"
                                         From="-220"
                                         To="900"
                                         Duration="0:0:4.7"
                                         BeginTime="0:0:0.4"
                                         RepeatBehavior="Forever"/>


                        <DoubleAnimation Storyboard.TargetName="EdgeSweepRight"
                                         Storyboard.TargetProperty="Y"
                                         From="900"
                                         To="-220"
                                         Duration="0:0:5.4"
                                         BeginTime="0:0:1.3"
                                         RepeatBehavior="Forever"/>

                    </Storyboard>

                </BeginStoryboard>

            </EventTrigger>


            <EventTrigger RoutedEvent="CheckBox.Checked"
                          SourceName="PauseMotion">

                <PauseStoryboard BeginStoryboardName="BackgroundMotion"/>

            </EventTrigger>


            <EventTrigger RoutedEvent="CheckBox.Unchecked"
                          SourceName="PauseMotion">

                <ResumeStoryboard BeginStoryboardName="BackgroundMotion"/>

            </EventTrigger>

        </Grid.Triggers>

    </Grid>

</Window>