                  ClipToBounds="True">

                <Rectangle Width="260"
                           Height="2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Opacity="0.88">

                    <Rectangle.Fill>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="1,0">

                            <GradientStop Color="#00FFFFFF"
