                    </Rectangle.RenderTransform>

                </Rectangle>

            </Grid>


            <!-- LEFT SWEEP -->

            <Grid Width="7"
                  HorizontalAlignment="Left"
                  ClipToBounds="True">

                <Rectangle Width="2"
                           Height="190"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Opacity="0.78">

                    <Rectangle.Fill>

                        <LinearGradientBrush StartPoint="0,0"
                                             EndPoint="0,1">

                            <GradientStop Color="#00FFFFFF"
                                          Offset="0"/>

                            <GradientStop Color="#708698FF"
                                          Offset="0.25"/>

                            <GradientStop Color="#EEF3FF"
                                          Offset="0.55"/>

                            <GradientStop Color="#708698FF"
                                          Offset="0.80"/>

                            <GradientStop Color="#00FFFFFF"
                                          Offset="1"/>

